# 在项目目录复制为 .env，再填写自己的值。不要把 .env 上传到 GitHub 或 Roam。
# 此处填写 API 根地址；程序会追加 /chat/completions。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# 填写供应商实际支持的模型名称；不预设会产生费用的模型。
OPENAI_MODEL=
# 可选：固定至少 16 字符的配对码；留空则每次启动重新生成。
BRIDGE_TOKEN=
PORT=17321
# yt-dlp 不在 PATH 时，设置完整路径。
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
